*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.h5
*.hdf5
*.pb
*.tflite
*.onnx
*.mlmodel
*.gguf
*.ggml
*.msgpack
*.npz
*.npy
*.joblib
*.pkl
*.pickle

# Tokenizer / embedding artefacts
*.model          # SentencePiece
*.vocab
*.bpe
*.vec
*.kv
*.faiss
*.index
*.ann
*.usearch
!*.card.json

# Vector store / search index directories
.chroma/
chroma_db/
qdrant_storage/
milvus_data/
lancedb/
.lancedb/
*.lance/

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

kubeconfig
*.kubeconfig
charts/*.tgz

docker-compose.override.yml
.docker/

# -----------------------------------------------------------------------------
# Editors, OS, and tooling
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.\#*
\#*\#
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Logs, caches, temporary files
# -----------------------------------------------------------------------------
*.log
/logs/
# ^ Root-level only. A bare `logs/` would exclude experiments/logs entirely, and
#   git cannot re-include files beneath an excluded directory — which would drop
#   that directory's .gitkeep and README.
tmp/
temp/
.tmp/
.cache/
*.bak
*.orig
*.rej
*.pid
*.seed
*.pid.lock
.scratch/
scratch/
