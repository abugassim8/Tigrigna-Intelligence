diff --git a/.github/workflows/verify.yml b/.github/workflows/verify.yml
index de0a149..4c58864 100644
--- a/.github/workflows/verify.yml
+++ b/.github/workflows/verify.yml
@@ -13,9 +13,13 @@ name: verify
 # ignored the whole time. This workflow exists so the newer rules do not
 # repeat that.
 
+# `push` is restricted to the default branch on purpose. With
+# `branches: ["**"]` every push to a branch with an open PR fired both this and
+# the pull_request trigger, giving 12 check runs for 6 jobs. Branch work is
+# already covered by pull_request.
 on:
   push:
-    branches: ["**"]
+    branches: [main]
   pull_request:
   workflow_dispatch:
 
@@ -152,6 +156,9 @@ jobs:
             tokenizers==0.23.1 \
             sacrebleu==2.6.0
           pip install --quiet -e services/primitives
+          # experiments/007-harness-fidelity imports tigrinya_eval. Without
+          # this the job reproduced five experiments and then died on import.
+          pip install --quiet -e services/evaluation
 
       - name: Re-run every experiment and diff its artefact
         run: |
@@ -200,6 +207,15 @@ jobs:
         with:
           python-version: "3.11"
 
+      # This job had no install at all, and runs the plant suite, whose
+      # morphology cases import tigrinya_eval -> metrics -> sacrebleu. Four
+      # plants "misbehaved" with ModuleNotFoundError on the first real run.
+      # The suite was right; the environment was wrong.
+      - name: Install the packages
+        run: |
+          pip install --quiet -e services/primitives
+          pip install --quiet -e services/evaluation
+
       - name: Screening tool runs and fails closed
         run: |
           set -euo pipefail
@@ -517,7 +533,13 @@ jobs:
         run: |
           set -euo pipefail
           fail=0
-          for id in $(grep -o 'DEC-[0-9]\{3\}' docs/decisions/DECISIONS.md | sort -u); do
+          # Definitions, not mentions. The first version iterated every
+          # DEC-NNN *mentioned* in the file, so a forward reference to a
+          # reserved-but-unwritten id failed the job: DEC-027 is the endpoint
+          # surface, blocked on A-02, and citing it is not deciding it. Same
+          # citation-vs-definition confusion already fixed for G-n/GAP-n.
+          for id in $(grep -oE '^## DEC-[0-9]{3}' docs/decisions/DECISIONS.md \
+                      | grep -oE 'DEC-[0-9]{3}' | sort -u); do
             if ! grep -qF "$id" docs/decisions/rejected_options.md; then
               echo "::error::$id has no entry in rejected_options.md (CONTRIBUTING rule 3)"
               fail=1
